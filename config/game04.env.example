# GAME04 only. Copy to .env.development.local or .env.preview.local (never commit values).
NEXT_PUBLIC_APP_ENV=preview
NEXT_PUBLIC_SUPABASE_URL=https://lrgyllgzcdcphlbmkknc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative to ANON_KEY; set one public key, not a server secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_USE_MOCK_DB=false
NEXT_PUBLIC_RAID_ROOM_UI_ENABLED=true
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_KPI_DATA_ENV=preview
NEXT_PUBLIC_ENABLE_QA_TOOLS=false

# Optional server-side KPI / identity transition. GAME04 project key only.
SUPABASE_SERVICE_ROLE_KEY=
KPI_BASIC_AUTH_USER=
KPI_BASIC_AUTH_PASSWORD=

# OAuth: GAME04 client and callback origin. Leave replacement disabled by default.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ACCOUNT_REPLACEMENT_ENABLED=false
GOOGLE_ACCOUNT_REPLACEMENT_ENABLED=false

# Test checkout only. Enable only after GAME04-specific sandbox configuration.
BILLING_MODE=sandbox
BILLING_SANDBOX_ENABLED=false
BILLING_RETURN_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CLI operations only; do not publish these to the browser.
SUPABASE_EXPECTED_PROJECT_REF=lrgyllgzcdcphlbmkknc
SUPABASE_PREVIEW_PROJECT_REF=lrgyllgzcdcphlbmkknc
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
