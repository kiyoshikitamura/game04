{
  "name": "game04",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:services": "node scripts/doctor.mjs --require-services",
    "test:bootstrap": "node scripts/verify-bootstrap.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.mjs",
    "test:browser": "npm run build && node scripts/run-browser-tests.mjs",
    "test:database": "node scripts/run-database-contracts.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contracts": "node scripts/verify-repository-contracts.mjs",
    "check:assets": "node scripts/verify-asset-manifest.mjs",
    "check": "npm run check:contracts && npm run check:assets && npm run test:unit && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.110.2",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
