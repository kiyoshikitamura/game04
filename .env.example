# Public browser configuration. These values are safe to expose, but must be
# different for dev-clean, preview, and production.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
TARGET_ENVIRONMENT=dev-clean
SENTRY_DSN=
